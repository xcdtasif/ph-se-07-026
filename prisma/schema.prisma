generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

generator erd {
  provider                  = "prisma-erd-generator"
  output                    = "../docs/generated/prisma-erd-generator/erd.svg"
  includeRelationFromFields = true
  showIndexes               = true
}
