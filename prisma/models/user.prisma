model User {
  id        String   @id @default(uuid())
  name      String
  email     String
  password  String
  role      UserRole
  isBanned  Boolean  @default(false) @map("is_banned")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties Property[]
  requests   Request[]
  reviews    Review[]

  @@unique([email])
  @@map("users")
}

enum UserRole {
  ADMIN
  LANDLORD
  TENANT
}
