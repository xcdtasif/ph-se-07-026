model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String
  role       UserRole @default(TENANT)
  is_banned  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  properties Property[]
  requests   Request[]
  reviews    Review[]

  @@map("users")
}

enum UserRole {
  ADMIN
  LANDLORD
  TENANT
}
